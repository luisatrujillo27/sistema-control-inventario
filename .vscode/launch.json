{
    // Configuraciones de ejecución para VS Code.
    // Pulsa F5 y elige una de las dos opciones.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flask: Sistema de inventario",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host=127.0.0.1",
                "--port=5000"
            ],
            "jinja": true,
            "autoStartBrowser": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Pruebas (unittest)",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "discover",
                "-v"
            ],
            "console": "integratedTerminal"
        }
    ]
}
